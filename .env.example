# Grade Business Trainer — local env

# Neon Postgres (required for login / history)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Auth.js — generate: openssl rand -base64 32
AUTH_SECRET=replace-me
AUTH_URL=http://localhost:3000

# Optional debug only: seconds per game week at 1×.
# Default is 50 → one quarter = 10 minutes (12 weeks).
# Example for faster local play: NEXT_PUBLIC_WEEK_SECONDS=8
# NEXT_PUBLIC_WEEK_SECONDS=50
